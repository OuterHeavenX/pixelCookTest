__pycache__/
*.pyc

# Godot's import cache. The .import and .uid files beside the assets are
# generated too, but Godot wants them committed - they are the stable identity
# of each resource.
godot/.godot/

# What the smoke test wrote as it ran. Useful for the ten seconds after a run
# hangs, worthless afterwards.
art/godot/progress.log
