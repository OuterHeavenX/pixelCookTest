__pycache__/
*.pyc

# Godot's import cache. The .import and .uid files beside the assets are
# generated too, but Godot wants them committed - they are the stable identity
# of each resource.
godot/.godot/

# What the smoke test wrote as it ran. Useful for the ten seconds after a run
# hangs, worthless afterwards.
art/godot/progress.log

# The touch run's screenshots. The desktop run's are committed as the record
# of what each screen looks like; a second set at phone shape is the same
# screens again and only doubles the churn.
art/web-touch/

# Whole-map renders at full resolution, megabytes each. The game reads the
# game-resolution copy under art/prerender/; these are the raw frames it was
# made from and are regenerated by tools/blender/town.py --full.
art/blender/full_*.png

# The browser harness's dependency, installed with npm ci from the lockfile.
node_modules/
